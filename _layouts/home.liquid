{%- assign h = site.data.home -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ h.name }}</title>
    <meta name="description" content="{{ h.name }}: {{ h.role }}, {{ h.affiliation }}. Research on LLM agents, evaluation, security, synthetic data, and reasoning.">
    <meta name="author" content="{{ h.name }}">
    <meta property="og:title" content="{{ h.name }}">
    <meta property="og:description" content="{{ h.lead | strip_html | strip }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ site.url }}{{ site.baseurl }}/">
    <meta property="og:image" content="{{ site.url }}{{ h.photo | relative_url }}">
    <meta name="twitter:card" content="summary">
    <link rel="canonical" href="{{ site.url }}{{ site.baseurl }}/">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%23141413'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='17' fill='%23FAF9F6' text-anchor='middle'%3EXL%3C/text%3E%3C/svg%3E">
    <script>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,300;0,6..72,400;0,6..72,500;1,6..72,300;1,6..72,400&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #faf9f6;
        --bg-raised: #ffffff;
        --bg-sunk: #f2f0ea;
        --ink: #141413;
        --ink-2: #3d3d3a;
        --muted: #73726c;
        --line: #e4e1d8;
        --line-strong: #cfcbbf;
        --accent: #b4441f;
        --accent-soft: rgba(180, 68, 31, 0.08);
        --curve-muted: #c9c5b9;
        --serif: "Newsreader", "Iowan Old Style", Georgia, serif;
        --sans: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --mono: "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;
        --w: 1120px;
        --gutter: 32px;
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          --bg: #0f0f0e; --bg-raised: #171715; --bg-sunk: #141412;
          --ink: #ecebe6; --ink-2: #c4c2bb; --muted: #8d8b84;
          --line: #262623; --line-strong: #3a3935;
          --accent: #e5815e; --accent-soft: rgba(229, 129, 94, 0.1);
          --curve-muted: #45433e;
          color-scheme: dark;
        }
      }
      :root[data-theme="dark"] {
        --bg: #0f0f0e; --bg-raised: #171715; --bg-sunk: #141412;
        --ink: #ecebe6; --ink-2: #c4c2bb; --muted: #8d8b84;
        --line: #262623; --line-strong: #3a3935;
        --accent: #e5815e; --accent-soft: rgba(229, 129, 94, 0.1);
        --curve-muted: #45433e;
        color-scheme: dark;
      }

      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; scroll-padding-top: 80px; -webkit-text-size-adjust: 100%; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font-family: var(--sans); font-size: 16px; line-height: 1.6;
        -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
        font-feature-settings: "ss01", "cv11";
      }
      a { color: inherit; text-decoration: none; }
      p a, .prose a, .news-text a {
        text-decoration: underline; text-decoration-color: var(--line-strong);
        text-underline-offset: 3px; text-decoration-thickness: 1px;
        transition: text-decoration-color .2s, color .2s;
      }
      p a:hover, .prose a:hover, .news-text a:hover { color: var(--accent); text-decoration-color: var(--accent); }
      ::selection { background: var(--accent); color: var(--bg); }
      :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }

      .wrap { max-width: var(--w); margin: 0 auto; padding: 0 var(--gutter); }
      .mono { font-family: var(--mono); font-size: 12px; letter-spacing: .02em; }
      .eyebrow { font-family: var(--mono); font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }

      /* ---------- Header ---------- */
      .site-header {
        position: sticky; top: 0; z-index: 50;
        background: color-mix(in srgb, var(--bg) 82%, transparent);
        backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);
        border-bottom: 1px solid transparent; transition: border-color .25s;
      }
      .site-header.scrolled { border-bottom-color: var(--line); }
      .nav { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 24px; }
      .wordmark { font-family: var(--serif); font-size: 21px; letter-spacing: -0.01em; white-space: nowrap; }
      .nav-links { display: flex; align-items: center; gap: 28px; font-size: 14px; color: var(--ink-2); }
      .nav-links a { position: relative; transition: color .2s; }
      .nav-links a:hover, .nav-links a.active { color: var(--ink); }
      .nav-links a.active::after {
        content: ""; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px; background: var(--ink);
      }
      .theme-toggle {
        width: 34px; height: 34px; display: inline-grid; place-items: center;
        border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--ink-2);
        cursor: pointer; transition: border-color .2s, color .2s;
      }
      .theme-toggle:hover { border-color: var(--line-strong); color: var(--ink); }
      .theme-toggle svg { width: 15px; height: 15px; }
      .icon-sun { display: none; }
      :root[data-theme="dark"] .icon-sun { display: block; }
      :root[data-theme="dark"] .icon-moon { display: none; }
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) .icon-sun { display: block; }
        :root:not([data-theme="light"]) .icon-moon { display: none; }
      }

      /* ---------- Hero ---------- */
      .hero { padding-top: 96px; padding-bottom: 72px; }
      .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 80px; align-items: start; }
      .hero h1 {
        font-family: var(--serif); font-weight: 400; font-size: clamp(44px, 6.4vw, 76px);
        line-height: 1.02; letter-spacing: -0.025em; margin: 18px 0 28px;
      }
      .lead {
        font-family: var(--serif); font-weight: 300; font-size: clamp(22px, 2.4vw, 28px);
        line-height: 1.35; letter-spacing: -0.01em; color: var(--ink); margin: 0 0 28px; max-width: 40ch;
      }
      .bio { color: var(--ink-2); font-size: 16.5px; max-width: 62ch; margin: 0 0 36px; }
      .link-row { display: flex; flex-wrap: wrap; gap: 10px; }
      .btn {
        display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px;
        border: 1px solid var(--line-strong); border-radius: 999px; font-size: 14px; color: var(--ink);
        transition: background .2s, border-color .2s, color .2s;
      }
      .btn:hover { border-color: var(--ink); }
      .btn.primary { background: var(--ink); border-color: var(--ink); color: var(--bg); }
      .btn.primary:hover { background: var(--accent); border-color: var(--accent); }
      .btn .arr { font-family: var(--mono); font-size: 12px; opacity: .6; }

      .portrait { margin: 0; }
      .portrait-frame {
        position: relative; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 4px; background: var(--bg-sunk);
      }
      .portrait img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; display: block; filter: grayscale(12%) contrast(1.02); }
      .portrait figcaption { display: flex; justify-content: space-between; margin-top: 12px; color: var(--muted); }
      .stats {
        display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 28px;
        border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
      }
      .stat { padding: 14px 0 12px; }
      .stat + .stat { padding-left: 16px; border-left: 1px solid var(--line); }
      .stat b { display: block; font-family: var(--serif); font-weight: 400; font-size: 30px; line-height: 1.1; letter-spacing: -0.02em; }
      .stat span { color: var(--muted); }
      .stats-note { margin-top: 8px; color: var(--muted); }
      .stats-note a:hover { color: var(--accent); }

      /* ---------- Sections ---------- */
      section.block { padding: 88px 0; border-top: 1px solid var(--line); }
      .block-head { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; margin-bottom: 44px; align-items: baseline; }
      .block-head h2 {
        font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 3.4vw, 40px);
        letter-spacing: -0.02em; line-height: 1.1; margin: 0;
      }
      .block-head p { margin: 0; color: var(--muted); max-width: 58ch; }
      .indent { margin-left: calc(220px + 48px); }

      /* ---------- Featured ---------- */
      .featured {
        display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        border: 1px solid var(--line); border-radius: 6px; background: var(--bg-raised); overflow: hidden;
      }
      .featured-body { padding: 44px 44px 40px; }
      .featured .kicker { color: var(--accent); }
      .featured h3 {
        font-family: var(--serif); font-weight: 400; font-size: clamp(26px, 2.8vw, 34px);
        line-height: 1.15; letter-spacing: -0.015em; margin: 14px 0 14px;
      }
      .featured .authors { font-size: 13.5px; color: var(--muted); margin: 0 0 22px; }
      .featured .summary { color: var(--ink-2); margin: 0 0 30px; }
      .metrics { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); margin: 0 0 30px; }
      .metric { padding: 16px 12px 14px 0; border-bottom: 1px solid var(--line); }
      .metric b { display: block; font-family: var(--serif); font-weight: 400; font-size: 28px; letter-spacing: -0.02em; line-height: 1.1; }
      .metric span { font-size: 12.5px; color: var(--muted); line-height: 1.35; display: block; margin-top: 4px; }
      .works { display: grid; gap: 28px; }
      .featured .kicker .idx { color: var(--muted); margin-right: 12px; }
      .featured .authors .me { color: var(--ink); font-weight: 500; }
      .points { list-style: none; margin: 0 0 30px; padding: 0; border-top: 1px solid var(--line); }
      .points li { padding: 14px 0; border-bottom: 1px solid var(--line); display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 16px; font-size: 14.5px; }
      .points b { font-weight: 500; }
      .points span { color: var(--ink-2); }
      .trend { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
      .trend.naive { stroke: var(--curve-muted); stroke-dasharray: 5 5; }
      .trend.kite { stroke: var(--accent); }
      .node { fill: var(--ink); }
      .svg-label.acc { fill: var(--accent); }
      .edit rect { fill: none; stroke: var(--line-strong); }
      .edit text { font-family: var(--mono); font-size: 9.5px; fill: var(--muted); }
      .edit.on rect { fill: var(--accent-soft); stroke: var(--accent); }
      .edit.on text { fill: var(--accent); }
      .flow { stroke: var(--line-strong); stroke-width: 1.2; }
      .ilp { fill: var(--bg-raised); stroke: var(--ink); }
      .track { stroke: var(--line-strong); stroke-width: 4; stroke-linecap: round; }
      .fill { stroke: var(--accent); stroke-width: 4; stroke-linecap: round; }
      .tick { stroke: var(--ink); stroke-width: 1.2; }
      .budget { fill: var(--line); }
      .budget-fill { fill: var(--accent); opacity: .55; }
      .featured-fig {
        background: var(--bg-sunk); border-left: 1px solid var(--line);
        display: flex; flex-direction: column; justify-content: center; padding: 36px 32px;
      }
      .featured-fig svg { width: 100%; height: auto; display: block; overflow: visible; }
      .featured-fig .fig-cap { margin-top: 18px; color: var(--muted); font-size: 13px; line-height: 1.5; }
      .featured-fig .fig-cap b { font-family: var(--mono); font-weight: 500; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); margin-right: 6px; }
      .icc { fill: none; stroke: var(--curve-muted); stroke-width: 1.5; }
      .icc.hot { stroke: var(--accent); stroke-width: 2; }
      .axis { stroke: var(--line-strong); stroke-width: 1; }
      .theta { stroke: var(--ink); stroke-width: 1; stroke-dasharray: 3 4; }
      .band { fill: var(--accent-soft); }
      .svg-label { font-family: var(--mono); font-size: 10px; fill: var(--muted); letter-spacing: .04em; }
      .svg-label.ink { fill: var(--ink); }
      .dot { fill: var(--bg-sunk); stroke: var(--accent); stroke-width: 2; }
      @media (prefers-reduced-motion: no-preference) {
        .icc.hot { stroke-dasharray: 600; stroke-dashoffset: 600; animation: draw 1.6s .2s cubic-bezier(.4,0,.2,1) forwards; }
        .dot { opacity: 0; animation: fade .5s 1.5s forwards; }
        @keyframes draw { to { stroke-dashoffset: 0; } }
        @keyframes fade { to { opacity: 1; } }
      }

      /* ---------- Research ---------- */
      .domains { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
      .domain { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; padding: 26px 0; border-bottom: 1px solid var(--line); }
      .domain .num { color: var(--accent); padding-top: 8px; }
      .domain-body { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.4fr); gap: 40px; align-items: baseline; }
      .domain h3 { font-family: var(--serif); font-weight: 400; font-size: 28px; line-height: 1.15; letter-spacing: -0.015em; margin: 0; }
      .domain p { margin: 0; color: var(--ink-2); font-size: 15.5px; }

      /* ---------- News ---------- */
      .news { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      .news li { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; padding: 18px 0; border-bottom: 1px solid var(--line); }
      .news-date { color: var(--muted); padding-top: 3px; }
      .news-text { color: var(--ink-2); }
      .news-text strong { color: var(--ink); font-weight: 500; }

      /* ---------- Publications ---------- */
      .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 36px; }
      .chip {
        font-family: var(--mono); font-size: 12px; letter-spacing: .02em; height: 30px; padding: 0 13px;
        border: 1px solid var(--line); border-radius: 999px; background: transparent; color: var(--ink-2); cursor: pointer;
        transition: border-color .2s, background .2s, color .2s;
      }
      .chip:hover { border-color: var(--line-strong); color: var(--ink); }
      .chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
      .chip .count { opacity: .55; margin-left: 4px; }
      .year-group { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; border-top: 1px solid var(--line); }
      .year-group[hidden] { display: none; }
      .year-label { padding-top: 22px; font-family: var(--serif); font-size: 26px; color: var(--muted); letter-spacing: -0.01em; }
      .pubs { list-style: none; margin: 0; padding: 0; }
      .pub { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 20px; padding: 22px 0; }
      .pub + .pub { border-top: 1px solid var(--line); }
      .pub[hidden] { display: none; }
      .badge {
        display: inline-block; font-family: var(--mono); font-size: 11px; font-weight: 500; letter-spacing: .04em;
        padding: 3px 0; color: var(--ink-2); border-top: 2px solid var(--line-strong); min-width: 56px; margin-top: 3px;
      }
      .badge.top { border-top-color: var(--accent); color: var(--ink); }
      .pub-title { font-size: 16.5px; font-weight: 500; line-height: 1.4; margin: 0 0 6px; letter-spacing: -0.005em; }
      .pub-title a:hover { color: var(--accent); }
      .pub-authors { font-size: 14px; color: var(--muted); margin: 0 0 4px; line-height: 1.55; }
      .pub-authors .me { color: var(--ink); font-weight: 500; }
      .pub-venue { font-family: var(--serif); font-style: italic; font-size: 15.5px; color: var(--ink-2); margin: 0; }
      .pub-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 10px; }
      .tag {
        font-family: var(--mono); font-size: 11px; letter-spacing: .03em; padding: 2px 9px; border-radius: 999px;
        border: 1px solid var(--line); color: var(--ink-2); transition: border-color .2s, color .2s;
      }
      a.tag:hover { border-color: var(--ink); color: var(--ink); }
      .tag.hl { border-color: transparent; background: var(--accent-soft); color: var(--accent); }
      .footnote { margin-top: 28px; color: var(--muted); font-size: 13px; }

      /* ---------- Experience / Education / Service ---------- */
      .two-col { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px; }
      .sub { margin: 0 0 4px; }
      .entries { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--ink); }
      .entry { padding: 20px 0; border-bottom: 1px solid var(--line); }
      .entry-when { color: var(--muted); }
      .entry h3 { font-size: 16.5px; font-weight: 500; margin: 6px 0 2px; letter-spacing: -0.005em; }
      .entry .org { font-family: var(--serif); font-style: italic; font-size: 16px; color: var(--ink-2); }
      .entry p { margin: 10px 0 0; font-size: 14.5px; color: var(--ink-2); }
      .col-title { margin-bottom: 14px; }

      /* ---------- Footer ---------- */
      footer { border-top: 1px solid var(--line); padding: 48px 0 56px; color: var(--muted); }
      .foot { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; align-items: baseline; }
      .foot .sig { font-family: var(--serif); font-size: 22px; color: var(--ink); }
      .foot-links { display: flex; gap: 22px; flex-wrap: wrap; font-size: 14px; }
      .foot-links a:hover { color: var(--ink); }

      /* ---------- Reveal ---------- */
      @media (prefers-reduced-motion: no-preference) {
        .js .reveal { opacity: 0; transform: translateY(14px); transition: opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1); }
        .js .reveal.in { opacity: 1; transform: none; }
      }

      /* ---------- Responsive ---------- */
      @media (max-width: 1000px) {
        .hero-grid { grid-template-columns: minmax(0, 1fr) 240px; gap: 48px; }
        .block-head, .news li, .year-group { grid-template-columns: 150px minmax(0, 1fr); gap: 32px; }
        .indent { margin-left: calc(150px + 32px); }
        .featured { grid-template-columns: 1fr; }
        .featured-fig { border-left: 0; border-top: 1px solid var(--line); }
        .domain { grid-template-columns: 150px minmax(0, 1fr); gap: 32px; }
        .domain-body { grid-template-columns: 1fr; gap: 8px; }
      }
      @media (max-width: 760px) {
        :root { --gutter: 16px; }
        .nav-links a:not(.keep) { display: none; }
        .hero { padding-top: 48px; padding-bottom: 56px; }
        .hero-grid { grid-template-columns: 1fr; gap: 40px; }
        .portrait { max-width: 320px; }
        section.block { padding: 64px 0; }
        .block-head, .news li, .year-group { grid-template-columns: 1fr; gap: 10px; }
        .block-head { margin-bottom: 28px; }
        .indent { margin-left: 0; }
        .year-label { padding-top: 18px; }
        .news li { padding: 16px 0; gap: 4px; }
        .featured-body { padding: 28px 22px; }
        .featured-fig { padding: 24px 18px; }
        .metrics { grid-template-columns: repeat(2, 1fr); }
        .domain { grid-template-columns: 1fr; gap: 6px; padding: 22px 0; }
        .domain .num { padding-top: 0; }
        .domain h3 { font-size: 24px; }
        .points li { grid-template-columns: 1fr; gap: 2px; }
        .pub { grid-template-columns: 1fr; gap: 8px; }
        .two-col { grid-template-columns: 1fr; gap: 48px; }
      }
      @media print {
        .site-header, .filters, .theme-toggle { display: none; }
        section.block { padding: 32px 0; }
      }
    </style>
  </head>
  <body>
    <script>document.documentElement.classList.add('js');</script>

    <header class="site-header" id="top">
      <div class="wrap nav">
        <a href="#top" class="wordmark">{{ h.name }}</a>
        <nav class="nav-links" aria-label="Sections">
          <a href="#work">Work</a>
          <a href="#research">Research</a>
          <a href="#news">News</a>
          <a href="#publications" class="keep">Publications</a>
          <a href="#experience">Experience</a>
          <a href="{{ h.cv | relative_url }}" class="keep">CV</a>
          <button class="theme-toggle" type="button" aria-label="Toggle color theme">
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      <!-- Hero -->
      <div class="wrap hero">
        <div class="hero-grid">
          <div>
            <div class="eyebrow">{{ h.role }} &middot; {{ h.affiliation }}</div>
            <h1>{{ h.name }}</h1>
            <p class="lead">{{ h.lead }}</p>
            <p class="bio">{{ h.bio }}</p>
            <div class="link-row">
              <a class="btn primary" href="mailto:{{ h.email }}">{{ h.email }}</a>
              {%- for l in h.links -%}
                {%- unless l.label == 'Email' -%}
                  {%- assign u = l.url -%}
                  {%- if u contains '://' -%}{%- else -%}{%- assign u = l.url | relative_url -%}{%- endif -%}
                  <a class="btn" href="{{ u }}" {% if u contains '://' %}target="_blank" rel="noopener"{% endif %}>{{ l.label }} <span class="arr">↗</span></a>
                {%- endunless -%}
              {%- endfor -%}
            </div>
          </div>
          <aside>
            <figure class="portrait">
              <div class="portrait-frame">
                <img src="{{ h.photo | relative_url }}" alt="Portrait of {{ h.name }}" width="949" height="1240">
              </div>
              <figcaption class="mono"><span>{{ h.affiliation }}</span><span>{{ h.location }}</span></figcaption>
            </figure>
            <div class="stats">
              {%- for s in h.stats.items -%}
                <div class="stat"><b>{{ s.value }}</b><span class="mono">{{ s.label }}</span></div>
              {%- endfor -%}
            </div>
            <div class="stats-note mono">
              <a href="https://scholar.google.com/citations?user=35otsO4AAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a>, {{ h.stats.as_of }}
            </div>
          </aside>
        </div>
      </div>

      <!-- Selected work -->
      <section class="block" id="work">
        <div class="wrap">
          <div class="block-head reveal">
            <h2>Work</h2>
            <p>Selected first-author papers, newest first.</p>
          </div>
          <div class="works">
          {%- for f in h.work -%}
          <article class="featured reveal">
            <div class="featured-body">
              <div class="eyebrow kicker"><span class="idx">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{{ f.kicker }}</div>
              <h3><a href="{{ f.links[0].url }}" target="_blank" rel="noopener">{{ f.title }}</a></h3>
              <p class="authors">{{ f.authors | replace: 'Xiaonan Luo', '<span class="me">Xiaonan Luo</span>' }}</p>
              <p class="summary">{{ f.summary }}</p>
              {%- if f.metrics -%}
              <div class="metrics">
                {%- for m in f.metrics -%}
                  <div class="metric"><b>{{ m.value }}</b><span>{{ m.label }}</span></div>
                {%- endfor -%}
              </div>
              {%- endif -%}
              {%- if f.points -%}
              <ul class="points">
                {%- for pt in f.points -%}
                  <li><b>{{ pt.title }}</b><span>{{ pt.body }}</span></li>
                {%- endfor -%}
              </ul>
              {%- endif -%}
              <div class="link-row">
                {%- for l in f.links -%}
                  <a class="btn{% if forloop.first %} primary{% endif %}" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} <span class="arr">↗</span></a>
                {%- endfor -%}
              </div>
            </div>
            <div class="featured-fig">
              {%- if f.fig == 'secprobe' -%}
              <svg viewBox="0 0 400 240" role="img" aria-label="Item characteristic curves: tasks whose difficulty is near the agent's estimated ability are the most informative, so SecProbe selects them.">
                <rect class="band" x="186" y="22" width="66" height="178" rx="2"/>
                <line class="axis" x1="40" y1="200" x2="364" y2="200"/>
                <line class="axis" x1="40" y1="22" x2="40" y2="200"/>
                <text class="svg-label" x="34" y="34" text-anchor="end">1</text>
                <text class="svg-label" x="34" y="203" text-anchor="end">0</text>
                <text class="svg-label" x="14" y="118" transform="rotate(-90 14 118)" text-anchor="middle">P(solve)</text>
                <text class="svg-label" x="364" y="218" text-anchor="end">task difficulty / ability θ →</text>
                <path class="icc" d="M40.0,187.8 L50.7,183.6 L61.3,178.3 L72.0,171.4 L82.7,163.0 L93.3,152.9 L104.0,141.3 L114.7,128.5 L125.3,115.0 L136.0,101.5 L146.7,88.7 L157.3,77.1 L168.0,67.0 L178.7,58.6 L189.3,51.7 L200.0,46.4 L210.7,42.2 L221.3,39.0 L232.0,36.7 L242.7,34.9 L253.3,33.6 L264.0,32.6 L274.7,31.9 L285.3,31.4 L296.0,31.0 L306.7,30.7 L317.3,30.5 L328.0,30.4 L338.7,30.3 L349.3,30.2 L360.0,30.1"/>
                <path class="icc" d="M40.0,200.0 L136.0,199.9 L178.7,199.6 L200.0,198.8 L221.3,196.6 L232.0,194.4 L242.7,190.8 L253.3,185.1 L264.0,176.3 L274.7,163.6 L285.3,146.6 L296.0,126.0 L306.7,104.0 L317.3,83.4 L328.0,66.4 L338.7,53.7 L349.3,44.9 L360.0,39.2"/>
                <path class="icc hot" d="M40.0,198.9 L50.7,198.6 L61.3,198.2 L72.0,197.7 L82.7,197.0 L93.3,196.2 L104.0,195.1 L114.7,193.7 L125.3,191.9 L136.0,189.6 L146.7,186.7 L157.3,183.2 L168.0,178.8 L178.7,173.5 L189.3,167.2 L200.0,159.7 L210.7,151.2 L221.3,141.7 L232.0,131.4 L242.7,120.5 L253.3,109.5 L264.0,98.6 L274.7,88.3 L285.3,78.8 L296.0,70.3 L306.7,62.8 L317.3,56.5 L328.0,51.2 L338.7,46.8 L349.3,43.3 L360.0,40.4"/>
                <path class="icc hot" d="M40.0,199.8 L50.7,199.7 L61.3,199.6 L72.0,199.3 L82.7,198.9 L93.3,198.3 L104.0,197.4 L114.7,196.1 L125.3,194.0 L136.0,190.8 L146.7,186.1 L157.3,179.4 L168.0,170.0 L178.7,157.5 L189.3,142.1 L200.0,124.3 L210.7,105.7 L221.3,87.9 L232.0,72.5 L242.7,60.0 L253.3,50.6 L264.0,43.9 L274.7,39.2 L285.3,36.0 L296.0,33.9 L306.7,32.6 L317.3,31.7 L328.0,31.1 L338.7,30.7 L349.3,30.4 L360.0,30.3"/>
                <line class="theta" x1="218.7" y1="14" x2="218.7" y2="200"/>
                <text class="svg-label ink" x="218.7" y="9" text-anchor="middle">θ̂ agent</text>
                <circle class="dot" cx="218.7" cy="92.2" r="4.5"/>
                <circle class="dot" cx="218.7" cy="144.1" r="4.5"/>
              </svg>
              {%- elsif f.fig == 'kite' -%}
              <svg viewBox="0 0 400 240" role="img" aria-label="Illustration: under naive self-training, strong skills rise while weak skills fall over generations; with KITE, both rise.">
                <line class="axis" x1="50" y1="200" x2="364" y2="200"/>
                <line class="axis" x1="50" y1="22" x2="50" y2="200"/>
                <text class="svg-label" x="20" y="112" transform="rotate(-90 20 112)" text-anchor="middle">skill accuracy</text>
                <text class="svg-label" x="60" y="216" text-anchor="middle">G0</text>
                <text class="svg-label" x="132.5" y="216" text-anchor="middle">G1</text>
                <text class="svg-label" x="205" y="216" text-anchor="middle">G2</text>
                <text class="svg-label" x="277.5" y="216" text-anchor="middle">G3</text>
                <text class="svg-label" x="350" y="216" text-anchor="middle">G4</text>
                <text class="svg-label" x="364" y="232" text-anchor="end">training generation →</text>
                <polyline class="trend naive" points="60,78 132.5,67.3 205,59.3 277.5,51.3 350,46.3"/>
                <polyline class="trend naive" points="60,142 132.5,155.3 205,166 277.5,176.7 350,184.7"/>
                <polyline class="trend kite" points="60,78 132.5,64.7 205,54 277.5,43.3 350,35.3"/>
                <polyline class="trend kite" points="60,142 132.5,126 205,112.7 277.5,102 350,94"/>
                <circle class="node" cx="60" cy="78" r="3.5"/><circle class="node" cx="60" cy="142" r="3.5"/>
                <text class="svg-label" x="66" y="94">strong skills</text>
                <text class="svg-label" x="66" y="170">weak skills</text>
                <text class="svg-label acc" x="356" y="116" text-anchor="end">KITE ↑</text>
                <text class="svg-label" x="356" y="168" text-anchor="end">naive ↓</text>
                <line class="trend kite" x1="232" y1="14" x2="252" y2="14"/><text class="svg-label" x="258" y="17">KITE</text>
                <line class="trend naive" x1="296" y1="14" x2="316" y2="14"/><text class="svg-label" x="322" y="17">naive</text>
              </svg>
              {%- elsif f.fig == 'refinelab' -%}
              <svg viewBox="0 0 400 240" role="img" aria-label="Schematic: candidate dataset edits are selected by an integer linear program to meet coverage, difficulty, and consistency targets within a token budget.">
                <text class="svg-label" x="20" y="18">candidate edits</text>
                <g class="edit on"><rect x="20" y="28" width="110" height="18" rx="2"/><text x="27" y="40">+ coverage</text></g>
                <g class="edit"><rect x="20" y="54" width="70" height="18" rx="2"/><text x="27" y="66">↑ difficulty</text></g>
                <g class="edit on"><rect x="20" y="80" width="90" height="18" rx="2"/><text x="27" y="92">✓ factual</text></g>
                <g class="edit"><rect x="20" y="106" width="60" height="18" rx="2"/><text x="27" y="118">+ coverage</text></g>
                <g class="edit on"><rect x="20" y="132" width="100" height="18" rx="2"/><text x="27" y="144">↑ difficulty</text></g>
                <g class="edit on"><rect x="20" y="158" width="64" height="18" rx="2"/><text x="27" y="170">✓ factual</text></g>
                <line class="flow" x1="140" y1="102" x2="166" y2="102"/>
                <rect class="ilp" x="168" y="82" width="58" height="40" rx="3"/>
                <text class="svg-label ink" x="197" y="106" text-anchor="middle">ILP</text>
                <line class="flow" x1="228" y1="102" x2="252" y2="102"/>
                <text class="svg-label" x="256" y="18">quality targets</text>
                <text class="svg-label" x="256" y="48">coverage</text>
                <line class="track" x1="256" y1="58" x2="380" y2="58"/><line class="fill" x1="256" y1="58" x2="336" y2="58"/><line class="tick" x1="336" y1="51" x2="336" y2="65"/>
                <text class="svg-label" x="256" y="98">difficulty</text>
                <line class="track" x1="256" y1="108" x2="380" y2="108"/><line class="fill" x1="256" y1="108" x2="318" y2="108"/><line class="tick" x1="318" y1="101" x2="318" y2="115"/>
                <text class="svg-label" x="256" y="148">consistency</text>
                <line class="track" x1="256" y1="158" x2="380" y2="158"/><line class="fill" x1="256" y1="158" x2="366" y2="158"/><line class="tick" x1="366" y1="151" x2="366" y2="165"/>
                <text class="svg-label" x="20" y="204">token budget</text>
                <rect class="budget" x="20" y="212" width="360" height="6" rx="3"/>
                <rect class="budget-fill" x="20" y="212" width="263" height="6" rx="3"/>
                <line class="theta" x1="300" y1="206" x2="300" y2="224"/>
                <text class="svg-label" x="380" y="204" text-anchor="end">limit</text>
              </svg>
              {%- endif -%}
              <p class="fig-cap"><b>{% if f.fig == 'secprobe' %}Idea{% elsif f.fig == 'kite' %}Finding{% else %}Method{% endif %}</b>{{ f.caption }}</p>
            </div>
          </article>
          {%- endfor -%}
          </div>
        </div>
      </section>

      <!-- Research -->
      <section class="block" id="research">
        <div class="wrap">
          <div class="block-head reveal">
            <h2>Research</h2>
            <p>I work on how language-model systems can improve themselves and act reliably in high-stakes settings.</p>
          </div>
          <ol class="domains reveal">
            {%- for r in h.research -%}
              <li class="domain">
                <div class="num mono">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</div>
                <div class="domain-body">
                  <h3>{{ r.title }}</h3>
                  <p>{{ r.body }}</p>
                </div>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      </section>

      <!-- News -->
      <section class="block" id="news">
        <div class="wrap">
          <div class="block-head reveal">
            <h2>News</h2>
          </div>
          <ul class="news reveal">
            {%- for n in h.news -%}
              <li><span class="news-date mono">{{ n.date }}</span><span class="news-text">{{ n.text }}</span></li>
            {%- endfor -%}
          </ul>
        </div>
      </section>

      <!-- Publications -->
      <section class="block" id="publications">
        <div class="wrap">
          <div class="block-head reveal">
            <h2>Publications</h2>
            <p>* denotes equal contribution. See <a href="https://scholar.google.com/citations?user=35otsO4AAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a> for the most up-to-date list.</p>
          </div>
          <div class="indent">
            <div class="filters" role="group" aria-label="Filter publications">
              {%- for t in h.topics -%}
                <button class="chip" type="button" data-filter="{{ t.key }}" aria-pressed="{% if t.key == 'all' %}true{% else %}false{% endif %}">{{ t.label }}<span class="count"></span></button>
              {%- endfor -%}
            </div>
          </div>
          {%- assign years = h.publications | group_by: 'year' -%}
          {%- for y in years -%}
            <div class="year-group">
              <div class="year-label">{{ y.name }}</div>
              <ul class="pubs">
                {%- for p in y.items -%}
                  {%- capture tags -%}{{ p.topics | join: ' ' }}{% if p.selected %} selected{% endif %}{% if p.first %} first{% endif %}{%- endcapture -%}
                  {%- assign top = false -%}
                  {%- if p.badge != 'Preprint' -%}{%- assign top = true -%}{%- endif -%}
                  <li class="pub" data-tags="{{ tags | strip }}">
                    <div><span class="badge{% if top %} top{% endif %}">{{ p.badge }}</span></div>
                    <div>
                      <p class="pub-title"><a href="{{ p.links[0].url }}" target="_blank" rel="noopener">{{ p.title }}</a></p>
                      <p class="pub-authors">{{ p.authors | replace: 'Xiaonan Luo', '<span class="me">Xiaonan Luo</span>' }}</p>
                      <p class="pub-venue">{{ p.venue }}, {{ p.year }}</p>
                      <div class="pub-meta">
                        {%- if p.note -%}<span class="tag hl">{{ p.note }}</span>{%- endif -%}
                        {%- for l in p.links -%}<a class="tag" href="{{ l.url }}" target="_blank" rel="noopener">{{ l.label }} ↗</a>{%- endfor -%}
                      </div>
                    </div>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        </div>
      </section>

      <!-- Experience, education, service -->
      <section class="block" id="experience">
        <div class="wrap">
          <div class="block-head reveal">
            <h2>Experience</h2>
          </div>
          <div class="indent two-col reveal">
            <div>
              <div class="eyebrow col-title">Research</div>
              <ul class="entries">
                {%- for e in h.experience -%}
                  <li class="entry">
                    <div class="entry-when mono">{{ e.when }}</div>
                    <h3>{{ e.title }}</h3>
                    <div class="org">{% if e.url %}<a href="{{ e.url }}" target="_blank" rel="noopener">{{ e.org }}</a>{% else %}{{ e.org }}{% endif %}</div>
                    {%- if e.body -%}<p class="prose">{{ e.body }}</p>{%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
            <div>
              <div class="eyebrow col-title">Education</div>
              <ul class="entries">
                {%- for e in h.education -%}
                  <li class="entry">
                    <div class="entry-when mono">{{ e.when }}</div>
                    <h3>{{ e.title }}</h3>
                    <div class="org">{{ e.org }}</div>
                    {%- if e.body -%}<p>{{ e.body }}</p>{%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
              <div class="eyebrow col-title" style="margin-top:40px">Service</div>
              <ul class="entries">
                {%- for s in h.service -%}
                  <li class="entry">
                    <h3 style="margin-top:0">{{ s.role }}</h3>
                    <div class="org">{{ s.items }}</div>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap foot">
        <div>
          <div class="sig">{{ h.name }}</div>
          <div class="mono" style="margin-top:6px">{{ h.affiliation }} &middot; Updated {{ site.time | date: '%b %Y' }}</div>
        </div>
        <div class="foot-links">
          {%- for l in h.links -%}
            {%- assign u = l.url -%}
            {%- if u contains ':' -%}{%- else -%}{%- assign u = l.url | relative_url -%}{%- endif -%}
            <a href="{{ u }}">{{ l.label }}</a>
          {%- endfor -%}
          <a href="#top">Back to top ↑</a>
        </div>
      </div>
    </footer>

    <script>
      (function () {
        var root = document.documentElement;

        // Theme toggle
        var btn = document.querySelector('.theme-toggle');
        btn.addEventListener('click', function () {
          var cur = root.getAttribute('data-theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var next = cur === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
        });

        // Header border on scroll
        var header = document.querySelector('.site-header');
        var onScroll = function () { header.classList.toggle('scrolled', window.scrollY > 8); };
        window.addEventListener('scroll', onScroll, { passive: true }); onScroll();

        // Active nav link
        var links = Array.prototype.slice.call(document.querySelectorAll('.nav-links a[href^="#"]'));
        if ('IntersectionObserver' in window) {
          var spy = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (!en.isIntersecting) return;
              links.forEach(function (a) { a.classList.toggle('active', a.getAttribute('href') === '#' + en.target.id); });
            });
          }, { rootMargin: '-40% 0px -55% 0px' });
          document.querySelectorAll('section.block[id]').forEach(function (s) { spy.observe(s); });

          // Reveal on scroll
          var rev = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('in'); rev.unobserve(en.target); } });
          }, { rootMargin: '0px 0px -8% 0px' });
          document.querySelectorAll('.reveal').forEach(function (el) { rev.observe(el); });
        } else {
          document.querySelectorAll('.reveal').forEach(function (el) { el.classList.add('in'); });
        }

        // Publication filters
        var pubs = Array.prototype.slice.call(document.querySelectorAll('.pub'));
        var groups = Array.prototype.slice.call(document.querySelectorAll('.year-group'));
        var chips = Array.prototype.slice.call(document.querySelectorAll('.chip'));
        var has = function (p, key) { return key === 'all' || (' ' + p.dataset.tags + ' ').indexOf(' ' + key + ' ') > -1; };
        chips.forEach(function (c) {
          var n = pubs.filter(function (p) { return has(p, c.dataset.filter); }).length;
          c.querySelector('.count').textContent = n;
          c.addEventListener('click', function () {
            var key = c.dataset.filter;
            chips.forEach(function (x) { x.setAttribute('aria-pressed', x === c ? 'true' : 'false'); });
            pubs.forEach(function (p) { p.hidden = !has(p, key); });
            groups.forEach(function (g) { g.hidden = !g.querySelector('.pub:not([hidden])'); });
          });
        });
      })();
    </script>
  </body>
</html>
