@article{luo2026secprobe,
  abbr={arXiv},
  title={SecProbe: Adaptive Evaluation of Coding Agents on Cybersecurity Vulnerabilities},
  author={Luo, Xiaonan and Huang, Yue and Guo, Kehan and He, Ping and Zou, Chuan and Gao, Chujie and Li, Lichi and Ma, Yuchen and Xu, Zhangchen and Chen, Zichen and Han, Yufei and Zhang, Xiangliang},
  journal={arXiv preprint arXiv:2609.33763},
  year={2026},
  bibtex_show={true},
  selected={true},
  arxiv={2609.33763},
  html={https://arxiv.org/abs/2609.33763},
  abstract={SecProbe is an adaptive evaluation framework for coding agents on cybersecurity vulnerabilities. It combines Item Response Theory with on-demand synthesis of repository-scale vulnerability-repair tasks, using observed performance to estimate agent ability and select or generate informative tasks. Across 353 tasks spanning six languages and 151 CWE types, nine frontier models reach at most 28.33% success, and SecProbe matches baseline ability estimates with up to 29.5% fewer tasks.}
}

